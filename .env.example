# Образец окружения. Скопировать в .env и заполнить.
# На сервере те же значения лежат в /etc/telegram-rag.env (см. deploy/README.md).

# --- Telegram: userbot ----------------------------------------------------
# Приложение с https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Строка сессии: `npm run login`. Полный доступ к аккаунту — секрет.
TELEGRAM_SESSION=
# Пул каналов при старте (дальше — через /api/admin/channels):
# @name, https://t.me/name, https://t.me/+invite (закрытый — аккаунт вступит)
TELEGRAM_CHANNELS=
# Сколько последних постов забрать у нового канала; 0 — всю историю
BACKFILL_LIMIT=0
# Догоняющий опрос каналов, секунды
POLL_INTERVAL_SECONDS=300

# --- Мультимодальные эмбеддинги ---------------------------------------------
# Поддерживаются только мультимодальные модели (текст плюс картинки и/или звук).
# Бэкенд выбирают переменные, нужна ровно одна из двух:
#   OPENROUTER_API_KEY — OpenRouter, по умолчанию Gemini Embedding 2 (1536);
#   EMBEDDING_BASE_URL — Ollama (нативный /api/embed, нужна свежая версия с
#                        мультимодальными эмбеддингами). Модель и размер вектора
#                        обязательны, ключ нужен только за прокси.
OPENROUTER_API_KEY=
# EMBEDDING_BASE_URL=http://ollama:11434
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=embeddinggemma-2      # OpenRouter: google/gemini-embedding-2
# EMBEDDING_DIMENSIONS=768              # OpenRouter: 1536; смена модели/размера сама переиндексирует базу
# EMBEDDING_SEND_DIMENSIONS=true
# Какие типы медиа умеет модель: image, audio, video. По умолчанию OpenRouter — все три,
# Ollama — image,audio (видео Ollama не принимает). Для тега без зрения или звука список
# сужают. Вектор строится только для этих типов: photo → image, voice и audio → audio,
# video, video_note и gif → video.
# EMBEDDING_MODALITIES=image,audio,video
# EMBEDDING_MAX_REQUEST_MB=32           # максимальный JSON-запрос с base64-медиа

# --- Оригиналы медиа и индексирование --------------------------------------
# Оригиналы всех вложений (фото, голосовые, кружки, аудио, видео, GIF) сохраняются в S3 и
# отдаются вместе с постом; вектора нет у тех, чей тип модель не принимает.
# Старые медиа до этой даты только архивируются, без эмбеддингов.
# MEDIA_SINCE=2026-01-01
# Фоново скачиваются вложения до 100 МиБ; крупнее (до 2048 МиБ) — по запросу get_post.
# Вектор строится только для вложений до 100 МиБ и 1800 секунд.
# MEDIA_CONCURRENCY=2
# Длительность сегмента и перекрытие для аудио/видео
# MEDIA_SEGMENT_SECONDS=60
# MEDIA_SEGMENT_OVERLAP_SECONDS=5

# --- Архив оригиналов медиа: S3-compatible storage ------------------------
# Обязательно. Endpoint можно не задавать для AWS S3.
# Для Neon требуется path-style addressing (значение по умолчанию — true).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=              # только для временных credentials
# S3_CREDENTIALS_EXPIRES_AT=     # обязательно с S3_SESSION_TOKEN, ISO 8601
S3_FORCE_PATH_STYLE=true
S3_URL_TTL_SECONDS=3600

# --- База -----------------------------------------------------------------
# Локально без Docker — встроенный Postgres (PGlite) в папке:
DATABASE_URL=pglite://./data/pglite
# В бою — облачный Postgres с pgvector (как завести — deploy/README.md):
#   Supabase (Connect → Session pooler):
#     postgresql://postgres.<ref>:<пароль>@aws-0-<регион>.pooler.supabase.com:5432/postgres?sslmode=require
#   Neon (Connect):
#     postgresql://<user>:<пароль>@ep-<…>.<регион>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Корневой сертификат Supabase (Database Settings → SSL Configuration): путь к файлу или PEM целиком
# DATABASE_CA_CERT=./supabase-ca.crt
# DATABASE_POOL_SIZE=5

# --- Доступ ---------------------------------------------------------------
# Если задан — MCP и API только с Authorization: Bearer <API_TOKEN> (или ?token=)
API_TOKEN=
# Токен владельца: добавление/удаление каналов. Без него управление выключено.
ADMIN_TOKEN=
# Адрес снаружи — для OpenAPI и подсказок
# PUBLIC_URL=https://telegram-rag.zomb.top
PORT=8000
LOG_LEVEL=info
