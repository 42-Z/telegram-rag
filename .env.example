# Образец окружения. Скопировать в .env и заполнить.
# На сервере те же значения лежат в /etc/telegram-rag.env (см. deploy/README.md).

# --- Telegram: userbot ----------------------------------------------------
# Приложение с https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Строка сессии: `npm run login`. Полный доступ к аккаунту — секрет.
TELEGRAM_SESSION=
# Пул каналов при старте (дальше — через /api/admin/channels):
# @name, https://t.me/name, https://t.me/+invite (закрытый — аккаунт вступит)
TELEGRAM_CHANNELS=
# Сколько последних постов забрать у нового канала; 0 — всю историю
BACKFILL_LIMIT=0
# Догоняющий опрос каналов, секунды
POLL_INTERVAL_SECONDS=300

# --- Эмбеддинги: любой OpenAI-совместимый сервис ---------------------------
# По умолчанию OpenRouter + Gemini. Для Ollama: EMBEDDING_BASE_URL=http://ollama:11434/v1,
# EMBEDDING_MODEL=nomic-embed-text, EMBEDDING_DIMENSIONS=768, EMBEDDING_SEND_DIMENSIONS=false
OPENROUTER_API_KEY=
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=               # если ключ не OpenRouter'овский
# EMBEDDING_MODEL=google/gemini-embedding-001
# EMBEDDING_DIMENSIONS=1536        # смена модели/размера сама переиндексирует базу
# EMBEDDING_SEND_DIMENSIONS=true

# --- Медиа → текст: фото, голосовые, кружки ------------------------------
# Мультимодальная модель (любой OpenAI-совместимый API): расшифровка речи,
# описание изображения, текст на картинке. Ключ — OPENROUTER_API_KEY или свой.
# Типы: photo, voice, video_note, audio, video, gif. Пусто — выключено.
MEDIA_TYPES=photo,voice,video_note
# MEDIA_MODEL=google/gemini-3.5-flash-lite
# MEDIA_BASE_URL=https://openrouter.ai/api/v1
# MEDIA_API_KEY=
# Разбирать медиа только новее этой даты — разбор всей истории может стоить денег
# MEDIA_SINCE=2026-01-01
# MEDIA_MAX_MB=20
# MEDIA_MAX_SECONDS=1800
# MEDIA_CONCURRENCY=2

# --- База -----------------------------------------------------------------
# Локально без Docker — встроенный Postgres (PGlite) в папке:
DATABASE_URL=pglite://./data/pglite
# В Docker/бою подставляется compose: postgres://telegram_rag:telegram_rag@db:5432/telegram_rag

# --- Доступ ---------------------------------------------------------------
# Если задан — MCP и API только с Authorization: Bearer <API_TOKEN> (или ?token=)
API_TOKEN=
# Токен владельца: добавление/удаление каналов. Без него управление выключено.
ADMIN_TOKEN=
# Адрес снаружи — для OpenAPI и подсказок
# PUBLIC_URL=https://telegram-rag.zomb.top
PORT=8000
LOG_LEVEL=info
